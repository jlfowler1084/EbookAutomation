[Unit]
Description=EbookAutomation Web Service (FastAPI)
After=network.target

[Service]
Type=simple
User=joe
WorkingDirectory=/home/joe/EbookAutomation
EnvironmentFile=/etc/web_service.env
ExecStart=/home/joe/EbookAutomation/.venv/bin/uvicorn web_service.main:app --host 127.0.0.1 --port 8001 --workers 2
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ebookweb

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# EB-332: KFX conversion runs Wine + Kindle Previewer 3 + Calibre at request
# time. ProtectSystem=strict makes the FS read-only except these paths, so the
# conversion subprocess needs its Wine prefix, Calibre config/cache, and KP3
# runtime dir writable — otherwise it hits EROFS. (WINEPREFIX/QtWebEngine env
# and the xvfb wrapper are set in pipeline_runner.run_premium, not here.)
ReadWritePaths=/home/joe/EbookAutomation/data /tmp /home/joe/.wine /home/joe/.config/calibre /home/joe/.cache/calibre /home/joe/.kindle

[Install]
WantedBy=multi-user.target
