ANTHROPIC_API_KEY=     # Optional: explicit Claude text/VQA selection only
OPENROUTER_API_KEY=    # Optional: explicit cloud VQA selection only
GEMINI_API_KEY=        # Optional: explicit Gemini OCR selection only
# Dedicated vision server for VQA and OCR (separate from the text gateway).
LOCAL_LLM_VISION_MODEL=sb-vision
LOCAL_LLM_BASE_URL=http://192.168.1.33:8080/v1
# Flash text gateway. A text endpoint must not be used for vision requests.
LOCAL_LLM_TEXT_MODEL=sb-chat
LOCAL_LLM_TEXT_BASE_URL=http://localhost:8000/v1
EBOOK_TEXT_PROVIDER=local
EBOOK_OCR_PROVIDER=local
CLOUD_VL_MODEL=qwen/qwen3-vl-30b-a3b-instruct
EBOOK_SMTP_PASSWORD=   # Kindle email delivery (smtp_user in settings.json kindle_delivery.email)

# Web Send-to-Kindle (Resend). Keep disabled until the live e2e + smoke pass.
WEB_SEND_TO_KINDLE_ENABLED=false
WEB_SEND_TO_KINDLE_FROM=kindle@leafbind.io
# Resend sending-access key restricted to leafbind.io.
WEB_RESEND_API_KEY=
# Resend/Svix signing secret for /webhooks/resend.
WEB_RESEND_WEBHOOK_SECRET=
