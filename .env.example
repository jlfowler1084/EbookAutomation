ANTHROPIC_API_KEY=     # Claude API -- baseline VQA + fallback re-invocation (SCRUM-281)
OPENROUTER_API_KEY=    # Qwen3-VL-A3B cloud primary (visual_qa.provider: cloud, SCRUM-283)
GEMINI_API_KEY=        # Gemini 2.5 Flash -- Tier 2.5 OCR fallback for scanned pages
LOCAL_LLM_VISION_MODEL=qwen3.5-35b-a3b-fp8
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
CLOUD_VL_MODEL=qwen/qwen3-vl-30b-a3b-instruct
EBOOK_SMTP_PASSWORD=   # Kindle email delivery (smtp_user in settings.json kindle_delivery.email)

# Web Send-to-Kindle (Resend). Keep disabled until the live e2e + smoke pass.
WEB_SEND_TO_KINDLE_ENABLED=false
WEB_SEND_TO_KINDLE_FROM=kindle@leafbind.io
# Resend sending-access key restricted to leafbind.io.
WEB_RESEND_API_KEY=
# Resend/Svix signing secret for /webhooks/resend.
WEB_RESEND_WEBHOOK_SECRET=
